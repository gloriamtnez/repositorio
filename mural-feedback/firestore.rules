rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /sessions/{sessionId}/responses/{responseId} {
      allow read: if true;

      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['words', 'authorId', 'createdAt'])
        && request.resource.data.keys().hasAll(['words', 'authorId', 'createdAt'])
        && request.resource.data.authorId is string
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.words is list
        && request.resource.data.words.size() >= 1
        && request.resource.data.words.size() <= 3
        && request.resource.data.words[0] is string
        && request.resource.data.words[0].size() >= 1
        && request.resource.data.words[0].size() <= 24
        && (request.resource.data.words.size() < 2 || (
          request.resource.data.words[1] is string
          && request.resource.data.words[1].size() >= 1
          && request.resource.data.words[1].size() <= 24
        ))
        && (request.resource.data.words.size() < 3 || (
          request.resource.data.words[2] is string
          && request.resource.data.words[2].size() >= 1
          && request.resource.data.words[2].size() <= 24
        ));

      allow update, delete: if false;
    }
  }
}
